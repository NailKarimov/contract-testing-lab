{
  "consumer": {
    "name": "PetAdoptionWeb"
  },
  "interactions": [
    {
      "description": "a request for a missing pet",
      "providerStates": [
        {
          "name": "a pet does not exist",
          "params": {
            "id": 2026101799
          }
        }
      ],
      "request": {
        "headers": {
          "Accept": "application/json"
        },
        "method": "GET",
        "path": "/pet/2026101799"
      },
      "response": {
        "status": 404
      }
    },
    {
      "description": "a request for an existing pet",
      "providerStates": [
        {
          "name": "a pet exists",
          "params": {
            "id": 2026101701,
            "name": "Rex"
          }
        }
      ],
      "request": {
        "headers": {
          "Accept": "application/json"
        },
        "method": "GET",
        "path": "/pet/2026101701"
      },
      "response": {
        "body": {
          "id": 2026101701,
          "name": "Rex",
          "status": "available"
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$.id": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "integer"
                }
              ]
            },
            "$.name": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.status": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "available|pending|sold"
                }
              ]
            }
          },
          "header": {
            "Content-Type": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "application/json.*"
                }
              ]
            }
          }
        },
        "status": 200
      }
    },
    {
      "description": "a request for available pets",
      "providerStates": [
        {
          "name": "there are available pets"
        }
      ],
      "request": {
        "headers": {
          "Accept": "application/json"
        },
        "method": "GET",
        "path": "/pet/findByStatus",
        "query": {
          "status": [
            "available"
          ]
        }
      },
      "response": {
        "body": [
          {
            "id": 1,
            "name": "doggie",
            "photoUrls": [
              "https://example.com/a.png"
            ]
          }
        ],
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type",
                  "min": 1
                }
              ]
            },
            "$[*].id": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "integer"
                }
              ]
            },
            "$[*].name": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$[*].photoUrls": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type",
                  "min": 1
                }
              ]
            }
          },
          "header": {
            "Content-Type": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "application/json.*"
                }
              ]
            }
          }
        },
        "status": 200
      }
    },
    {
      "description": "a request to register a pet",
      "providerStates": [
        {
          "name": "a pet does not exist",
          "params": {
            "id": 2026101702
          }
        }
      ],
      "request": {
        "body": {
          "id": 2026101702,
          "name": "Bella",
          "photoUrls": [
            "https://example.com/bella.png"
          ],
          "status": "available"
        },
        "headers": {
          "Accept": "application/json",
          "Content-Type": "application/json"
        },
        "method": "POST",
        "path": "/pet"
      },
      "response": {
        "body": {
          "id": 2026101702
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          },
          "header": {
            "Content-Type": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "application/json.*"
                }
              ]
            }
          }
        },
        "status": 200
      }
    },
    {
      "description": "a request to reserve a pet",
      "providerStates": [
        {
          "name": "a pet exists",
          "params": {
            "id": 2026101701,
            "name": "Rex"
          }
        }
      ],
      "request": {
        "headers": {
          "Accept": "application/json"
        },
        "method": "POST",
        "path": "/pet/2026101701",
        "query": {
          "name": [
            "Rex"
          ],
          "status": [
            "pending"
          ]
        }
      },
      "response": {
        "body": {
          "id": 2026101701,
          "name": "Rex",
          "status": "pending"
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$.id": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "integer"
                }
              ]
            },
            "$.name": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          },
          "header": {
            "Content-Type": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "application/json.*"
                }
              ]
            }
          }
        },
        "status": 200
      }
    }
  ],
  "metadata": {
    "pact-js": {
      "version": "17.1.4"
    },
    "pactRust": {
      "ffi": "0.5.8",
      "models": "1.3.16"
    },
    "pactSpecification": {
      "version": "3.0.0"
    }
  },
  "provider": {
    "name": "Petstore"
  }
}